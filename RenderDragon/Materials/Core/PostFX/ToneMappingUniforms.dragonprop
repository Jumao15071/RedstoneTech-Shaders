[Vector] LuminanceMinMaxAndWhitePointAndMinWhitePoint : (0.0, 0.0, 0.0, 0.0) // min, max, fixed whitepoint, min whitepoint
[Vector] TonemapParams0 : (0.0, 0.0, 0.0, 0.0) // tonemapper, tonemapping enabled, pre exposure enabled, unused
[Float] RasterizedColorEnabled : 1.0 // RasterizedColor is blended on backbuffer if this uniform is greater than zero

