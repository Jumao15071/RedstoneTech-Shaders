#pragma once

vec4 projToView(vec4 p, mat4 inverseProj)
{	
#if BGFX_SHADER_LANGUAGE_GLSL
	p = vec4(
		p.x * inverseProj[0][0],
		p.y * inverseProj[1][1],
		p.w * inverseProj[3][2],
		p.z * inverseProj[2][3] + p.w * inverseProj[3][3]
	);
#else
	p = vec4(
		p.x * inverseProj[0][0],
		p.y * inverseProj[1][1],
		p.w * inverseProj[2][3],
		p.z * inverseProj[3][2] + p.w * inverseProj[3][3]
	);
#endif
				
	p /= p.w;
	return p;
}

// Converts a world coordinate to normalized device coordinates
// viewProj: view projection matrix
vec3 worldToNdc(vec3 worldPos, mat4 viewProj){
	vec4 clipSpacePos = mul(viewProj, vec4(worldPos, 1.0));
	vec3 ndc = clipSpacePos.xyz / clipSpacePos.w;
	return ndc;
}

// Returns world position at the given uv
// uv: uv of pixel you want to convert to world position
vec3 getWorldPosFromDepthTexture(float depth, vec2 uv, mat4 inverseView, mat4 inverseProj){
	vec2 xy = uv * 2.0 - 1.0;

	// Flip Y for non GL platforms to account for the different axis conventions betwen UV and NDC positions
#if !BGFX_SHADER_LANGUAGE_GLSL
	xy.y *= -1.0;
#endif

#if BGFX_SHADER_LANGUAGE_GLSL
	// Translate the depth value from the depth texture range [0,1] to the OpenGL NDC depth range [-1,1].
	depth = depth * 2.0f - 1.0f;
#endif
	vec4 viewPosition = projToView(vec4(xy, depth, 1.0), inverseProj);
	return mul(inverseView, vec4(viewPosition.xyz, 1.0)).xyz;
}

// Gets the corresponding uv of a world position
vec2 worldToUv(vec3 worldPos, mat4 viewProj){
	vec3 ndc = worldToNdc(worldPos, viewProj);

	// Unconditional Y flip to get into D3D UV space. transformUVForScreen requires D3D coords
	ndc.y *= -1.0;

	//Convert XY from [-1, 1] to [0, 1] range.
	vec2 uv = 0.5 * (ndc.xy + vec2(1.0, 1.0));

	// Do platform specific UV transforms
	uv = transformUVForScreen(uv);
	return uv;
}

// Reprojects uv coordinates into the previous frame
vec2 getPreviousUV(float depth, vec2 currentUV, mat4 inverseView, mat4 inverseProj, mat4 prevViewProj) {
	vec3 currentWorldSpacePos = getWorldPosFromDepthTexture(depth, currentUV, inverseView, inverseProj);
	vec3 prevNDCSpace =  worldToNdc(currentWorldSpacePos, prevViewProj);

	vec2 prevUV = (prevNDCSpace.xy + 1.0f) * 0.5f;
	// UV coordinate Y needs flipped since transformUVForScreen expects (0, 0) as the top left corner
	prevUV.y = 1.0f - prevUV.y;
	return transformUVForScreen(prevUV);
}

// Approximates normal of the surface using change in view position over fragments
vec3 getApproximatedWorldSurfaceNormal(vec3 viewPos, mat4 inverseView) {
	vec3 viewPosChangeInX = normalize(dFdx(viewPos));
	vec3 viewPosChangeInY = normalize(dFdy(viewPos));
	
	vec3 approximatedSurfaceNormalInViewSpace = normalize(cross(viewPosChangeInX, viewPosChangeInY));
	vec3 approximatedSurfaceNormalInWorldSpace = normalize(mul(inverseView, vec4(approximatedSurfaceNormalInViewSpace, 0.0f)).xyz);

	return approximatedSurfaceNormalInWorldSpace;
}

// Quantizes the world position based on texel size
vec3 getQuantizedWorldPosition(vec3 worldPos, vec3 viewPos, mat4 inverseView, float texelGridSize, float surfaceNormalPrecision) {
	vec3 approximatedSurfaceNormal = getApproximatedWorldSurfaceNormal(viewPos, inverseView);

	// Rounding the surface normal helps guard against artifacts that result as imprecisions in the approximation of surface normal
	approximatedSurfaceNormal = normalize(round(approximatedSurfaceNormal / surfaceNormalPrecision) * surfaceNormalPrecision);

	// Quantize base world position
	vec3 worldPosRemainder = mod(worldPos, texelGridSize);

	// Remove anything in the normal direction from the quantized position
	vec3 baseWorldPosNormalComponent = dot(worldPosRemainder, approximatedSurfaceNormal) * approximatedSurfaceNormal;
	worldPosRemainder -= baseWorldPosNormalComponent;

	vec3 quantizedWorldPosition = worldPos - worldPosRemainder;
	return quantizedWorldPosition;
}
