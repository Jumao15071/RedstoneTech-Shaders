#pragma once

#include "Standard/Lighting/Common.dragonh"

void computeLighting_BlinnPhong_Vertex(VertexInput vInput, inout VertexOutput vOutput, vec3 worldPosition)
{
	vec3 objectNormal = vInput.normal.xyz;
	vec3 viewSpaceNormal = mul(WorldView, vec4(objectNormal, 0.0)).xyz;

	vOutput.viewSpaceNormal = viewSpaceNormal;
	vOutput.viewSpacePosition = mul(View, vec4(worldPosition, 1.0));
}

vec3 computeLighting_BlinnPhong(
	FragmentInput fragInput,
	StandardSurfaceInput stdInput,
	StandardSurfaceOutput stdOutput,
	DirectionalLight primaryLight)
{
	vec3 N = normalize(fragInput.viewSpaceNormal);
	vec3 L = normalize(-primaryLight.ViewSpaceDirection);

	vec3 ambientIntensity = LightAmbientColorAndIntensity.rgb * LightAmbientColorAndIntensity.w;

	float NdotL = dot(N, L);
	vec3 diffuseIntensity = saturate(NdotL) * primaryLight.Intensity;

	vec3 V = normalize(-fragInput.viewSpacePosition.xyz);
	vec3 H = normalize(L + V);

	// based on https://seblagarde.wordpress.com/2011/08/17/hello-world/
	float roughness = clamp(stdOutput.Roughness, 0.05, 0.95);
	float specularExponent = 2.0 / pow4(roughness) - 2.0; // alpha_p
	float normalizationFactor = (specularExponent + 2.0) / (4.0 * M_PI * (2.0 - exp2(-specularExponent / 2.0)));

	vec3 specularIntensity = saturate(normalizationFactor * power(saturate(dot(N, H)), specularExponent)) * primaryLight.Intensity;

	return ambientIntensity * stdOutput.Albedo
		 + diffuseIntensity * stdOutput.Albedo
		 + specularIntensity * stdOutput.Albedo;
}
