#pragma once

#include "Util/ColorUtil.dragonh"

CONST(int kTonemapperReinhard) = 0;
CONST(int kTonemapperReinhardLuma) = 1;
CONST(int kTonemapperReinhardLuminance) = 2;
CONST(int kTonemapperHable) = 3;
CONST(int kTonemapperACES) = 4;
CONST(int kTonemapperGeneric) = 5;

// 0.18 is also used when pre-exposure is enabled and should be updated in the `PreExposureUtil.dragonh` functions if changed here.
CONST(float kMiddleGray) = 0.18;

//
// Reinhard
// https://www-old.cs.utah.edu/docs/techreports/2002/pdf/UUCS-02-001.pdf equation 3
//

vec3 TonemapReinhard(vec3 rgb) {
	vec3 color = rgb / (1.0 + rgb);
	return color;
}

//
// Reinhard-Luma
// https://www-old.cs.utah.edu/docs/techreports/2002/pdf/UUCS-02-001.pdf equation 4
//

vec3 TonemapReinhardLuma(vec3 rgb, float W) {
	return (rgb * (vec3_splat(1.0) + (rgb / vec3_splat(W)))) / (vec3_splat(1.0) + rgb);
}

//
// Reinhard-Luminance
// https://www-old.cs.utah.edu/docs/techreports/2002/pdf/UUCS-02-001.pdf equation 4 applied to luminance
//

vec3 TonemapReinhardLuminance(vec3 rgb, float W) {
	float l_old = luminance(rgb);
	float l_new = (l_old * (1.0 + (l_old / W))) / (1.0 + l_old);
	return rgb * (l_new / l_old);
}

//
// Hable
//

vec3 HableTonemap(vec3 x) {
	float A = 0.15;
	float B = 0.50;
	float C = 0.10;
	float D = 0.20;
	float E = 0.02;
	float F = 0.30;
	return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - E / F;
}

vec3 TonemapHable(vec3 rgb, float W) {
	const float ExposureBias = 2.0;

	vec3 curr = HableTonemap(ExposureBias * rgb);
	vec3 whiteScale = 1.0 / HableTonemap(vec3_splat(W));

	return curr * whiteScale;
}

//
// ACES
//

vec3 RRTAndODTFit(vec3 v) {
	vec3 a = v * (v + 0.0245786) - 0.000090537;
	vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
	return a / b;
}

vec3 ACESFitted(vec3 rgb) {
	mat3 ACESInputMat = mtxFromRows(
		vec3(0.59719, 0.35458, 0.04823),
		vec3(0.07600, 0.90834, 0.01566),
		vec3(0.02840, 0.13383, 0.83777)
	);

	mat3 ACESOutputMat = mtxFromRows(
		vec3( 1.60475, -0.53108, -0.07367),
		vec3(-0.10208,  1.10813, -0.00605),
		vec3(-0.00327, -0.07276,  1.07602)
	);

	rgb = mul(ACESInputMat, rgb);
	rgb = RRTAndODTFit(rgb);
	rgb = mul(ACESOutputMat, rgb);

	rgb = saturate(rgb);

	return rgb;
}

vec3 TonemapACES(vec3 rgb) {
	return ACESFitted(rgb);
}

//
// Timothy Lottes' generic tone mapping operator
// https://gpuopen.com/wp-content/uploads/2016/03/GdcVdrLottes.pdf
//

vec3 TonemapGeneric(vec3 rgb) {
	float peak = max(rgb.r, max(rgb.g, rgb.b));
	vec3 ratio = rgb / peak;

	peak = power(peak, GenericTonemapperContrast);
	peak = peak / (GenericTonemapperScale * peak + GenericTonemapperOffset);

	ratio = power(ratio, vec3_splat(1.0f / GenericTonemapperCrosstalkSaturation));
	ratio = mix(ratio, vec3(1.0f, 1.0f, 1.0f), power(peak, GenericTonemapperCrosstalk));
	ratio = power(ratio, vec3_splat(GenericTonemapperCrosstalkSaturation));

	return peak * ratio;
}

//
// Creates an exposure value using the scenes average luminance based on a middle gray of 0.18.
//

float CalcExposure(float averageLuminance, float compensation) {
	return (kMiddleGray / averageLuminance) * compensation;
}

//
// Tone map driver
//

vec3 ApplyGammaCurve(vec3 color) {
	// Compute the final luminance before we apply gamma correction
	// TODO: Is this correct? Should it be the value AFTER gamma?
	float finalLuminance = luminance(color);

	// Apply the gamma curve
	vec3 gradingVector = getGradingVector(
		GammaHighlights,
		GammaShadows,
		GammaMidtones,
		kMiddleGray,
		finalLuminance,
		2.2f,
		GammaHighlightsEnabled,
		GammaMidtonesEnabled,
		GammaShadowsEnabled);

	return color_gamma(color, ColorGrading_OptimizeGammaCorrectionEnabled, PlayerUIGamma, gradingVector);
}

vec3 ApplyTonemap(vec3 sceneColor, float scaledWhitePoint, int tonemapper) {
	float whitePointSquared = scaledWhitePoint * scaledWhitePoint;

	// Apply the tone map operator
	if (tonemapper == kTonemapperReinhardLuma) {
		sceneColor = TonemapReinhardLuma(sceneColor, whitePointSquared);
	}
	else if (tonemapper == kTonemapperReinhardLuminance) {
		sceneColor = TonemapReinhardLuminance(sceneColor, whitePointSquared);
	}
	else if (tonemapper == kTonemapperHable) {
		sceneColor = TonemapHable(sceneColor, whitePointSquared);
	}
	else if (tonemapper == kTonemapperACES) {
		sceneColor = TonemapACES(sceneColor);
	}
	else if (tonemapper == kTonemapperGeneric) {
		sceneColor = TonemapGeneric(sceneColor);
	}
	else {
		sceneColor = TonemapReinhard(sceneColor);
	}

	return ApplyGammaCurve(sceneColor);
}
