}

vec4 bgfxTextureGather(BgfxSamplerCubeArray _sampler, vec4 _coord, int comp)
{
	if (comp == 0)
	{
		return _sampler.m_texture.GatherRed(_sampler.m_sampler, _coord);
	}
	else if (comp == 1)
	{
		return _sampler.m_texture.GatherGreen(_sampler.m_sampler, _coord);
	}
	else if (comp == 2)
