vec3 instMul(vec3 _vec, mat3 _mtx) { return mul(_vec, _mtx); }
vec3 instMul(mat3 _mtx, vec3 _vec) { return mul(_mtx, _vec); }
vec4 instMul(vec4 _vec, mat4 _mtx) { return mul(_vec, _mtx); }
vec4 instMul(mat4 _mtx, vec4 _vec) { return mul(_mtx, _vec); }

float rcp(float _a) { return 1.0/_a; }
vec2  rcp(vec2  _a) { return vec2(1.0)/_a; }
vec3  rcp(vec3  _a) { return vec3(1.0)/_a; }
vec4  rcp(vec4  _a) { return vec4(1.0)/_a; }
#endif // BGFX_SHADER_LANGUAGE_*

#	if	BGFX_SHADER_LANGUAGE_ESSL > 0
#		define SAMPLER2DEXTERNAL(_name, _precision, _reg, _regsampler)		uniform _precision samplerExternalOES _name
#	else
#		define SAMPLER2DEXTERNAL(_name, _precision, _reg, _regsampler)		SAMPLER2D(_name, _precision, _reg, _regsampler)
#	endif

vec2 vec2_splat(float _x) { return vec2(_x, _x); }
vec3 vec3_splat(float _x) { return vec3(_x, _x, _x); }
vec4 vec4_splat(float _x) { return vec4(_x, _x, _x, _x); }

ivec2 ivec2_splat(int _x) { return ivec2(_x, _x); }
ivec3 ivec3_splat(int _x) { return ivec3(_x, _x, _x); }
ivec4 ivec4_splat(int _x) { return ivec4(_x, _x, _x, _x); }

#if BGFX_SHADER_LANGUAGE_GLSL >= 130 || BGFX_SHADER_LANGUAGE_HLSL || BGFX_SHADER_LANGUAGE_PSSL || BGFX_SHADER_LANGUAGE_SPIRV || BGFX_SHADER_LANGUAGE_METAL
uvec2 uvec2_splat(uint _x) { return uvec2(_x, _x); }
uvec3 uvec3_splat(uint _x) { return uvec3(_x, _x, _x); }
uvec4 uvec4_splat(uint _x) { return uvec4(_x, _x, _x, _x); }
#endif // BGFX_SHADER_LANGUAGE_GLSL >= 130 || BGFX_SHADER_LANGUAGE_HLSL || BGFX_SHADER_LANGUAGE_PSSL || BGFX_SHADER_LANGUAGE_SPIRV || BGFX_SHADER_LANGUAGE_METAL

mat4 mtxFromRows(vec4 _0, vec4 _1, vec4 _2, vec4 _3)
{
#if BGFX_SHADER_LANGUAGE_GLSL
    return transpose(mat4(_0, _1, _2, _3) );
#else
    return mat4(_0, _1, _2, _3);
#endif // BGFX_SHADER_LANGUAGE_GLSL
}

mat4 mtxFromCols(vec4 _0, vec4 _1, vec4 _2, vec4 _3)
{
#if BGFX_SHADER_LANGUAGE_GLSL
    return mat4(_0, _1, _2, _3);
#else
    return transpose(mat4(_0, _1, _2, _3) );
#endif // BGFX_SHADER_LANGUAGE_GLSL
}

mat3 mtxFromRows(vec3 _0, vec3 _1, vec3 _2)
{
#if BGFX_SHADER_LANGUAGE_GLSL
    return transpose(mat3(_0, _1, _2) );
#else
    return mat3(_0, _1, _2);
#endif // BGFX_SHADER_LANGUAGE_GLSL
}

mat3 mtxFromCols(vec3 _0, vec3 _1, vec3 _2)
{
#if BGFX_SHADER_LANGUAGE_GLSL
    return mat3(_0, _1, _2);
#else
    return transpose(mat3(_0, _1, _2) );
#endif // BGFX_SHADER_LANGUAGE_GLSL
}

#if BGFX_SHADER_LANGUAGE_ESSL <= 100 && !BGFX_SHADER_LANGUAGE_PSSL
float trunc(float _f)
{
	return float(int(_f));
}
#endif

#if (BGFX_SHADER_LANGUAGE_GLSL && BGFX_SHADER_LANGUAGE_GLSL < 400 && !BGFX_SHADER_LANGUAGE_ESSL) || (BGFX_SHADER_LANGUAGE_ESSL && BGFX_SHADER_LANGUAGE_ESSL < 310)
vec4 textureGather(sampler2D _sampler, vec2 _coord, int comp)
{
#if (BGFX_SHADER_LANGUAGE_ESSL >= 300)
	ivec2 coord = ivec2(_coord * textureSize(_sampler, 0));
#else
	// TODO: compile out this function entirely for ESSL100 once we've fully
	// deprecated it
	// ESSL 100 -- unsupported
	ivec2 coord = ivec2(_coord);
#endif

	if (comp == 0)
	{
		return vec4(texelFetch(_sampler, coord + ivec2(0, 1), 0).x,
		            texelFetch(_sampler, coord + ivec2(1, 1), 0).x,
		            texelFetch(_sampler, coord + ivec2(1, 0), 0).x,
		            texelFetch(_sampler, coord, 0).x);
	}
	else if (comp == 1)
	{
		return vec4(texelFetch(_sampler, coord + ivec2(0, 1), 0).y,
		            texelFetch(_sampler, coord + ivec2(1, 1), 0).y,
		            texelFetch(_sampler, coord + ivec2(1, 0), 0).y,
		            texelFetch(_sampler, coord, 0).y);
	}
	else if (comp == 2)
	{
		return vec4(texelFetch(_sampler, coord + ivec2(0, 1), 0).z,
		            texelFetch(_sampler, coord + ivec2(1, 1), 0).z,
		            texelFetch(_sampler, coord + ivec2(1, 0), 0).z,
		            texelFetch(_sampler, coord, 0).z);
	}
	else if (comp == 3)
	{
		return vec4(texelFetch(_sampler, coord + ivec2(0, 1), 0).w,
		            texelFetch(_sampler, coord + ivec2(1, 1), 0).w,
		            texelFetch(_sampler, coord + ivec2(1, 0), 0).w,
		            texelFetch(_sampler, coord, 0).w);
	}
	return vec4(0, 0, 0, 0);
}
#endif

#if (BGFX_SHADER_LANGUAGE_ESSL && BGFX_SHADER_LANGUAGE_ESSL < 300)
#	define sampler2DArray sampler2D
#	define sampler2DArrayShadow sampler2D
#endif

#if !BGFX_SHADER_LANGUAGE_PSSL
float fmod(float _a, float _b) { return _a - _b * trunc(_a / _b); }
vec2 fmod(vec2 _a, vec2 _b) { return vec2(fmod(_a.x,_b.x), fmod(_a.y,_b.y)); }
vec3 fmod(vec3 _a, vec3 _b) { return vec3(fmod(_a.x,_b.x), fmod(_a.y,_b.y), fmod(_a.z,_b.z)); }
vec4 fmod(vec4 _a, vec4 _b) { return vec4(fmod(_a.x,_b.x), fmod(_a.y,_b.y), fmod(_a.z,_b.z), fmod(_a.w,_b.w)); }
#endif

#if BGFX_SHADER_NEEDS_UNIFORMS_BLOCK > 0
#	define BGFX_BEGIN_UNIFORM_BLOCK(Name, Reg) layout(std140) uniform Name {
#	define BGFX_END_UNIFORM_BLOCK };
#else
#if BGFX_SHADER_LANGUAGE_HLSL
#	define BGFX_BEGIN_UNIFORM_BLOCK(Name, Reg) cbuffer Name : register(b##Reg) {
#	define BGFX_END_UNIFORM_BLOCK };
#else
#	define BGFX_BEGIN_UNIFORM_BLOCK(Name, Reg)
#	define BGFX_END_UNIFORM_BLOCK
#endif
#endif

#if (BGFX_SHADER_LANGUAGE_HLSL > 0) || (BGFX_SHADER_LANGUAGE_METAL > 0) || (BGFX_SHADER_LANGUAGE_SPIRV > 0) || (BGFX_SHADER_LANGUAGE_PSSL > 0)
#	define transformUVForScreen(_coord) vec2((_coord).x, (_coord).y)
#else
#	define transformUVForScreen(_coord) (vec2((_coord).x, 1.0 - (_coord).y))
#endif

// Helpers to return the min/max/product/sum of values in a vector

#define lengthSqr(_a) dot(_a, _a)

float min2(vec2 _a) { return min(_a.x, _a.y); }
float min3(vec3 _a) { return min(_a.x, min(_a.y, _a.z)); }
float min4(vec4 _a) { vec2 _min2 = min(_a.xy, _a.zw); return min(_min2.x, _min2.y); }

float max2(vec2 _a) { return max(_a.x, _a.y); }
float max3(vec3 _a) { return max(_a.x, max(_a.y, _a.z)); }
float max4(vec4 _a) { vec2 _max2 = max(_a.xy, _a.zw); return max(_max2.x, _max2.y); }

float prod2(vec2 _a) { return _a.x * _a.y; }
float prod3(vec3 _a) { return _a.x * _a.y * _a.z; }
float prod4(vec4 _a) { vec2 _prod2 = _a.xy * _a.zw; return _prod2.x * _prod2.y; }

float sum2(vec2 _a) { return _a.x + _a.y; }
float sum3(vec3 _a) { return _a.x + _a.y + _a.z; }
float sum4(vec4 _a) { vec2 _sum2 = _a.xy + _a.zw; return _sum2.x + _sum2.y; }

// Pow variants that require 3 or fewer multiplies

// pow(x, 1.5)
float pow1_5(float x) { return x * sqrt(x); }
vec2  pow1_5(vec2  x) { return x * sqrt(x); }
vec3  pow1_5(vec3  x) { return x * sqrt(x); }
vec4  pow1_5(vec4  x) { return x * sqrt(x); }

// pow(x, 2.0)  # 1 multiply
float pow2(float x) { return x * x; }
vec2  pow2(vec2  x) { return x * x; }
vec3  pow2(vec3  x) { return x * x; }
vec4  pow2(vec4  x) { return x * x; }

// pow(x, 3.0)  # 2 multiplies
float pow3(float x) { return x * x * x; }
vec2  pow3(vec2  x) { return x * x * x; }
vec3  pow3(vec3  x) { return x * x * x; }
vec4  pow3(vec4  x) { return x * x * x; }

// pow(x, 4.0)  # 2 multiplies
float pow4(float x) { float x2 = x * x; return x2 * x2; }
vec2  pow4(vec2  x) { vec2  x2 = x * x; return x2 * x2; }
vec3  pow4(vec3  x) { vec3  x2 = x * x; return x2 * x2; }
vec4  pow4(vec4  x) { vec4  x2 = x * x; return x2 * x2; }

// pow(x, 5.0)  # 3 multiplies
float pow5(float x) { float x2 = x * x; return x2 * x2 * x; }
vec2  pow5(vec2  x) { vec2  x2 = x * x; return x2 * x2 * x; }
vec3  pow5(vec3  x) { vec3  x2 = x * x; return x2 * x2 * x; }
vec4  pow5(vec4  x) { vec4  x2 = x * x; return x2 * x2 * x; }

// pow(x, 6.0)  # 3 multiplies
float pow6(float x) { float x2 = x * x; return x2 * x2 * x2; }
vec2  pow6(vec2  x) { vec2  x2 = x * x; return x2 * x2 * x2; }
vec3  pow6(vec3  x) { vec3  x2 = x * x; return x2 * x2 * x2; }
vec4  pow6(vec4  x) { vec4  x2 = x * x; return x2 * x2 * x2; }

// pow7 skipped as it requires 4 multiplies

// pow(x, 8.0)  # 3 multiplies
float pow8(float x) { float x4 = pow4(x); return x4 * x4; }
vec2  pow8(vec2  x) { vec2  x4 = pow4(x); return x4 * x4; }
vec3  pow8(vec3  x) { vec3  x4 = pow4(x); return x4 * x4; }
vec4  pow8(vec4  x) { vec4  x4 = pow4(x); return x4 * x4; }

// pow(x, y), undefined for x < 0
// Note: redefined pow as power so the linter can catch and warn about explicit uses of pow
float power(float x, float y) { return pow(x, y); }
vec2  power(vec2  x, vec2  y) { return pow(x, y); }
vec3  power(vec3  x, vec3  y) { return pow(x, y); }
vec4  power(vec4  x, vec4  y) { return pow(x, y); }
#endif // __cplusplus

// On platforms which supports Compute, including the compute header produces valid
// code. This is helpful as a generic shader can still technically access RWBuffer and so on
#include "bgfx_compute.dragonh"

// bgfx_raytracing.dragonh is safely guarded with preprocessor directives, but contain macros 
// that are important to ensure PS4 materials do not fail
#include "bgfx_raytracing.dragonh"

#endif // BGFX_SHADER_H_HEADER_GUARD
