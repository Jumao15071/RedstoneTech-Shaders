#		define USAMPLER2D(_name, _precision, _reg, _regsampler) SAMPLER2D(_name, _precision, _reg, _regsampler)
#		define ISAMPLER3D(_name, _precision, _reg, _regsampler) SAMPLER3D(_name, _precision, _reg, _regsampler)
#		define USAMPLER3D(_name, _precision, _reg, _regsampler) SAMPLER3D(_name, _precision, _reg, _regsampler)
