#		define TEXTURE2DARRAY(_name, _precision, _reg, _regsampler)       NoopSampler _name
#		define TEXTURE2DMS(_name, _precision, _reg, _regsampler)          NoopSampler _name
#		define TEXTURE2DSHADOW(_name, _precision, _reg, _regsampler)      NoopSampler _name
#		define TEXTURE2DARRAYSHADOW(_name, _precision, _reg, _regsampler) NoopSampler _name
#		define TEXTURE3D(_name, _precision, _reg, _regsampler)            NoopSampler _name
#		define TEXTURECUBE(_name, _precision, _reg, _regsampler)          NoopSampler _name
#		define TEXTURECUBEARRAY(_name, _precision, _reg, _regsampler)     NoopSampler _name

#		define TEXTURE2D_ARRAY(_name, _precision, _reg, _regsampler, _size)             NoopSampler _name[_size]
#		define TEXTURE2DARRAY_ARRAY(_name, _precision, _reg, _regsampler, _size)        NoopSampler _name[_size]
#		define TEXTURE2DMS_ARRAY(_name, _precision, _reg, _regsampler, _size)           NoopSampler _name[_size]
#		define TEXTURE2DSHADOW_ARRAY(_name, _precision, _reg, _regsampler, _size)       NoopSampler _name[_size]
#		define TEXTURE2DARRAYSHADOW_ARRAY(_name, _precision, _reg, _regsampler, _size)  NoopSampler _name[_size]
#		define TEXTURE3D_ARRAY(_name, _precision, _reg, _regsampler, _size)             NoopSampler _name[_size]
#		define TEXTURECUBE_ARRAY(_name, _precision, _reg, _regsampler, _size)           NoopSampler _name[_size]
#		define TEXTURECUBEARRAY_ARRAY(_name, _precision, _reg, _regsampler, _size)      NoopSampler _name[_size]

#	define STRUCTUREDBUFFER(_bindingName, _name, _type, _reg) layout(std430, binding = _reg) buffer _bindingName { _type _name []; }
#	define RWSTRUCTUREDBUFFER(_bindingName, _name, _type, _reg) layout(std430, binding = _reg) buffer _bindingName { _type _name []; }

	// Used as a substitute for compilation of fallback shaders 
#	define STRUCTUREDBUFFER_ARRAY(_bindingName, _name, _type, _reg, _size) layout(std430) buffer _bindingName { _type _name [][_size]; }
#	define RWSTRUCTUREDBUFFER_ARRAY(_bindingName, _name, _type, _reg, _size) layout(std430) buffer _bindingName { _type _name [][_size]; }

#	if BGFX_SHADER_LANGUAGE_GLSL >= 130 || BGFX_SHADER_LANGUAGE_ESSL >= 300
