#		define SAMPLER2DSHADOW(_name, _precision, _reg, _regsampler) uniform _precision sampler2DShadow _name

#		define SAMPLER2DARRAY(_name, _precision, _reg, _regsampler)       uniform _precision sampler2DArray _name
#		define SAMPLER2DMSARRAY(_name, _precision, _reg, _regsampler)     uniform _precision sampler2DMSArray _name
#		define SAMPLERCUBEARRAY(_name, _precision, _reg, _regsampler)     uniform _precision samplerCubeArray _name
#		define SAMPLER2DARRAYSHADOW(_name, _precision, _reg, _regsampler) uniform _precision sampler2DArrayShadow _name
#	endif

#if BGFX_SHADER_LANGUAGE_ESSL > 0  && GL_FRAGMENT_PRECISION_HIGH
#define DEFAULT_PRECISION highp
#elif BGFX_SHADER_LANGUAGE_ESSL > 0 
#define DEFAULT_PRECISION mediump
#else
#define DEFAULT_PRECISION 
#endif

vec4 textureSample(DEFAULT_PRECISION sampler2D _sampler, vec2 _coord)                  { return texture(_sampler, _coord);}
vec4 textureSample(DEFAULT_PRECISION sampler3D _sampler, vec3 _coord)                  { return texture(_sampler, _coord);}
vec4 textureSample(DEFAULT_PRECISION samplerCube _sampler, vec3 _coord)                { return texture(_sampler, _coord);}
vec4 textureSample(DEFAULT_PRECISION sampler2D _sampler, vec2 _coord, float _lod)      { return textureLod(_sampler, _coord, _lod);}
vec4 textureSample(DEFAULT_PRECISION sampler3D _sampler, vec3 _coord, float _lod)      { return textureLod(_sampler, _coord, _lod);}
#	if BGFX_SHADER_LANGUAGE_ESSL > 100
vec4 textureSample(DEFAULT_PRECISION sampler2DArray _sampler, vec3 _coord)               { return texture(_sampler, _coord);}
vec4 textureSample(DEFAULT_PRECISION sampler2DArray _sampler, vec3 _coord, float _lod)   { return textureLod(_sampler, _coord, _lod);}
#	elif BGFX_SHADER_LANGUAGE_ESSL == 100
vec4 texture2D(NoopSampler _sampler, vec2 _coord)                    { return vec4(0,0,0,0);}
#	endif // BGFX_SHADER_LANGUAGE_ESSL > 100

#	if BGFX_SHADER_LANGUAGE_ESSL >= 310 
vec4 textureSample(DEFAULT_PRECISION samplerCubeArray _sampler, vec4 _coord, float _lod) { return textureLod(_sampler, _coord, _lod);}
#	endif // BGFX_SHADER_LANGUAGE_ESSL >= 310 

vec4 textureSample(NoopSampler noopsampler, vec2 _coord)             { return vec4(0,0,0,0);}
vec4 textureSample(NoopSampler noopsampler, vec3 _coord)             { return vec4(0,0,0,0);}
vec4 textureSample(NoopSampler noopsampler, vec4 _coord)             { return vec4(0,0,0,0);}
vec4 textureSample(NoopSampler noopsampler, vec2 _coord, float _lod) { return vec4(0,0,0,0);}
vec4 textureSample(NoopSampler noopsampler, vec3 _coord, float _lod) { return vec4(0,0,0,0);}
vec4 textureSample(NoopSampler noopsampler, vec4 _coord, float _lod) { return vec4(0,0,0,0);}
NoopSampler getSampler(NoopSampler _sampler, NoopSampler _samplerState){ return _sampler;}

#		define SAMPLER_STATE(_name, _reg) NoopSampler _name
