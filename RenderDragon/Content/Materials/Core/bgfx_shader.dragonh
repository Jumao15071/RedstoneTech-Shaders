		return _sampler.m_texture.GatherAlpha(_sampler.m_sampler, _coord);
	}
	return vec4(0, 0, 0, 0);
}

#	define GET_SAMPLER_FUNCTION(_bgfxtype, _textureType, _samplerStateType) \
	_bgfxtype getSampler(_textureType _texture, _samplerStateType _samplerState) \
	{ \
		_bgfxtype bgfxSampler; \
		bgfxSampler.m_texture = _texture; \
		bgfxSampler.m_sampler = _samplerState.m_samplerState; \
		return bgfxSampler; \
	}

vec4 bgfxTexture2D(NoopSampler _sampler, vec2 _coord)                             { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTexture2DLod(NoopSampler _sampler, vec2 _coord, float _level)            { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTexture2DProj(NoopSampler _sampler, vec3 _coord)                         { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTexture2DProj(NoopSampler _sampler, vec4 _coord)                         { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTexture2DGrad(NoopSampler _sampler, vec2 _coord, vec2 _dPdx, vec2 _dPdy) { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTexture2DArray(NoopSampler _sampler, vec3 _coord)                        { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTexture2DArrayLod(NoopSampler _sampler, vec3 _coord, float _lod)         { return vec4(0.0,0.0,0.0,0.0);}
float bgfxShadow2D(NoopSampler _sampler, vec3 _coord)                             { return 0.0;}
float bgfxShadow2DProj(NoopSampler _sampler, vec4 _coord)                         { return 0.0;}
vec4 bgfxTexture3D(NoopSampler _sampler, vec3 _coord)                             { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTexture3DLod(NoopSampler _sampler, vec3 _coord, float _level)            { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTextureCube(NoopSampler _sampler, vec3 _coord)                           { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTextureCubeLod(NoopSampler _sampler, vec3 _coord, float _level)          { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTextureCubeArray(NoopSampler _sampler, vec4 _coord)                      { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTextureCubeArrayLod(NoopSampler _sampler, vec4 _coord, float _level)     { return vec4(0.0,0.0,0.0,0.0);}
vec4 bgfxTexelFetch(NoopSampler _sampler, ivec2 _coord, int _lod)                 { return vec4(0.0,0.0,0.0,0.0);}
vec2 bgfxTextureSize(NoopSampler _sampler, int _lod)                              { return vec2(0.0,0.0);}
vec4 bgfxTextureGather(NoopSampler _sampler, vec2 _coord, int comp)               { return vec4(0.0,0.0,0.0,0.0);}
NoopSampler getSampler(NoopSampler _sampler, BgfxSamplerState _samplerState)      { return _sampler;}
NoopSampler getSampler(NoopSampler _sampler, NoopSampler _samplerState)           { return _sampler;}

#		define SAMPLER2D(_name, _precision, _reg, _regsampler) \
			uniform SamplerState _name ## Sampler : REGISTER(s, _regsampler); \
			uniform Texture2D _name ## Texture : REGISTER(t, _reg); \
			static BgfxSampler2D _name = { _name ## Sampler, _name ## Texture }
#		define SAMPLER2D_INTRINSIC_SAMPLER_STATE(_name, _samplerState, _precision, _reg, _regsampler) \
			uniform Texture2D _name ## Texture : REGISTER(t, _reg); \
			static BgfxSampler2D _name = { _samplerState, _name ## Texture }
#		define ISAMPLER2D(_name, _precision, _reg, _regsampler) \
			uniform Texture2D<ivec4> _name ## Texture : REGISTER(t, _reg); \
			static BgfxISampler2D _name = { _name ## Texture }
#		define USAMPLER2D(_name, _precision, _reg, _regsampler) \
			uniform Texture2D<uvec4> _name ## Texture : REGISTER(t, _reg); \
			static BgfxUSampler2D _name = { _name ## Texture }
#		define sampler2D BgfxSampler2D
#		define texture2D(_sampler, _coord) bgfxTexture2D(_sampler, _coord)
#		define texture2DLod(_sampler, _coord, _level) bgfxTexture2DLod(_sampler, _coord, _level)
#		define texture2DProj(_sampler, _coord) bgfxTexture2DProj(_sampler, _coord)
#		define texture2DGrad(_sampler, _coord, _dPdx, _dPdy) bgfxTexture2DGrad(_sampler, _coord, _dPdx, _dPdy)

#		define SAMPLER2DARRAY(_name, _precision, _reg, _regsampler) \
			uniform SamplerState _name ## Sampler : REGISTER(s, _regsampler); \
			uniform Texture2DArray _name ## Texture : REGISTER(t, _reg); \
			static BgfxSampler2DArray _name = { _name ## Sampler, _name ## Texture }
#		define sampler2DArray BgfxSampler2DArray
#		define texture2DArray(_sampler, _coord) bgfxTexture2DArray(_sampler, _coord)
#		define texture2DArrayLod(_sampler, _coord, _lod) bgfxTexture2DArrayLod(_sampler, _coord, _lod)

#		define SAMPLER2DMS(_name, _precision, _reg, _regsampler) \
			uniform Texture2DMS<vec4> _name ## Texture : REGISTER(t, _reg); \
			static BgfxSampler2DMS _name = { _name ## Texture }
#		define sampler2DMS BgfxSampler2DMS

#		define SAMPLER2DSHADOW(_name, _precision, _reg, _regsampler) \
			uniform SamplerComparisonState _name ## SamplerComparison : REGISTER(s, _regsampler); \
