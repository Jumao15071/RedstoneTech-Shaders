#		define USAMPLER2D(_name, _precision, _reg, _regsampler) uniform _precision usampler2D _name
#		define ISAMPLER3D(_name, _precision, _reg, _regsampler) uniform _precision isampler3D _name
#		define USAMPLER3D(_name, _precision, _reg, _regsampler) uniform _precision usampler3D _name

#		define texture2D(_sampler, _coord)        textureSample(_sampler, _coord)
#		define texture2DArray(_sampler, _coord)   textureSample(_sampler, _coord)
#		define texture3D(_sampler, _coord)        textureSample(_sampler, _coord)
#		define textureCube(_sampler, _coord)      textureSample(_sampler, _coord)
#		define textureCubeArray(_sampler, _coord) textureSample(_sampler, _coord)

#		define texture2DLod(_sampler, _coord, _lod)        textureSample(_sampler, _coord, _lod)
#		define texture2DArrayLod(_sampler, _coord, _lod)   textureSample(_sampler, _coord, _lod)
#		define texture3DLod(_sampler, _coord, _lod)        textureSample(_sampler, _coord, _lod)
#		define textureCubeArrayLod(_sampler, _coord, _lod) textureSample(_sampler, _coord, _lod)
