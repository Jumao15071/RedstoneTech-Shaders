#pragma once

#include "Util/ColorUtil.dragonh"

struct ToneMappingPSOutStruct
{
	vec4 OutColor;
};

vec3 setSaturation(vec3 color, float saturation) {
	return lerp(luminance(color), color, saturation);
}

vec3 setSaturationAverage(vec3 color, float saturation) {
	return lerp(lumaAverage(color), color, saturation);
}

vec3 colorGrading(vec3 inputColor) {
	// Apply color temperature & tint
	inputColor = inputColor * gToneMappingColorBalance.rgb;

	// Adjust contrast & saturation
	inputColor = saturate((gToneMappingContrast * (inputColor - 0.18)) + 0.18); // 0.18 = Mid level grey
	inputColor = setSaturation(inputColor, gToneMappingSaturation);

	// Apply gamma 
	inputColor = power(inputColor, gToneMappingGamma);

	return inputColor;
}

// Photographic Tone Reproduction for Digital Images:
// http://www.cs.utah.edu/~reinhard/cdrom/tonemap.pdf
vec3 reinhardToneMapper(vec3 inputColor) {
	float inputLuminance = luminance(inputColor);

	// (Eq. 4) Scale the luminance down to compress bright highlights to representable LDR values
	float outputLuminance = inputLuminance / (1.0 + inputLuminance);

	// (Not Reinhard Operator) Make the curve S-shaped to boost shadow contrast
	// Should only activate when outputLuminance < e^gToneMappingShadowContrastEnd
	outputLuminance *= power(min(1.0, outputLuminance * exp(-gToneMappingShadowContrastEnd)), gToneMappingShadowContrast);

	// Apply output luminance to the input
	return inputColor * (outputLuminance / inputLuminance);
}

// Heji and Burgess-Dawson Tone Curve:
// http://filmicworlds.com/blog/filmic-tonemapping-operators/
vec3 filmicToneMapper(vec3 inputColor){
	vec3 x = max(0, inputColor - 0.004);
	x = (x * (6.2 * x + 0.5)) / (x * (6.2 * x + 1.7) + 0.06);

	// Simple sRGB conversion, since this is only visible in debug mode
	if (gPerformSRGBConversion != 0.0) {
		return power(x, 2.2);
	}
	else {
		return x;
	}
}

// Dynamic tone mapper based on Eilertsen, Mantiuk, and Unger's paper
// *Real-time noise-aware tone mapping*. Applies a luminance-based tone curve
// generated by the renderer_d3d12_rtx code, and then applies filmic
// saturation emulation.
vec3 dynamicToneMapper(vec3 inputColor) {
	float kToneCurveMinStops = -24.0;
	float kToneCurveMaxStops = 4.0;

	// Calculate luminance of color, and avoid values that would result in computing the log of 0:
	float lum = max(luminance(inputColor), kToneCurveMinStops);

	// Map to the space the tone curve uses:
	float logLuminance = log2(lum);
	float biasedLuminance = (logLuminance - kToneCurveMinStops) / (kToneCurveMaxStops - kToneCurveMinStops);

	// We can now use the sampler to perform linear interpolation!
	// Note that we're doing this on a log-log chart of the tone curve.
	// The 0.5 here comes from the fact that the tone curve texture is 1 texel tall.
	float outLogLuminance = texture2DLod(gToneCurve, vec2(biasedLuminance, 0.5), 0.0).r;
	float outLuminance = exp2(outLogLuminance);

	// Apply the luminance shift to the color:
	vec3 mappedColor = inputColor * outLuminance / lum;

	// Filmic saturation adjustments
	//
	// The Heji and Burgess-Dawson filmic tone curve saturates darker tones
	// and desaturates lighter tones, which I like. This emulates that using
	// a rational polynomial lightly fitted to the action of that tone curve
	// on saturation, in linear space.
	//
	// Here's the idea: We can measure the saturation of a color using
	//   sat(x) = (max(x) - min(x)) / max(x)
	// (there are a few different ways to do this, but they give the same result).
	// Now consider applying a per-component tone mapper f to the color
	//   (x-dx, x, x+dx).
	// The saturation of this color is 2*dx/x. As it turns out, the first-order
	// approximation of the saturation of (f(x-dx), f(x), f(x+dx)) is
	//   2*dx*(f'(x) + O(dx))/f(x)
	// so to a first approximation, applying f multiplies the saturation by a
	// factor of x * f'(x) / f(x).
	// To emulate this effect, we suppose we're given y = f(x), and then attempt
	// to find the amount of saturation the filmic tone curve would have applied.
	//
	// After accounting for the fact that the Heji Burgess-Dawson tone curve
	// maps into sRGB space, fitting a rational function to its saturation curve,
	// and using luma instead of the RGB average (which is an artistic choice),
	// we get the code below.
	//
	float filmicLuma = lumaAverage(mappedColor);

	// (-1489.7 x^2 + 1486.4 x - 3.3)/(0.15 x^2 + 944.2 x + 1.0)
	float saturationAdjustment = (filmicLuma * (-1489.7 * filmicLuma + 1486.4) - 3.3) / (filmicLuma * (0.15 * filmicLuma + 944.2) + 1.0);

	// Now, an extra hack on top of that: We only allow this adjustment to
	// increase the level of saturation, instead of also applying desaturation
	// to brighter tones!
	mappedColor = setSaturationAverage(mappedColor, 1.0 + gToneMappingFilmicSaturationCorrection * max(0.0, saturationAdjustment - 1.0));

	return mappedColor;
}

// Converts a single channel from linear RGB to sRGB.
float linearRGBToSRGB(float value) {
	// Implementation note: https://entropymine.com/imageworsener/srgbformula/
	// talks about how the standard linear <-> sRGB conversion functions aren't
	// exactly inverses of each other, but the differences are small enough
	// that we use the standard formula instead.
	if (value < 0.0031308) {
		return value * 12.92;
	}
	else {
		return 1.055 * power(value, 1.0 / 2.4) - 0.055;
	}
}

// Cwanonverts a three-component color from linear RGB to sRGB.
vec3 linearRGBToSRGB(vec3 color) {
	return vec3(
		linearRGBToSRGB(color.r),
		linearRGBToSRGB(color.g),
		linearRGBToSRGB(color.b)
	);
}

// Get the adjustment from the index matrix at a given point.
// This value should always be in [-0.5/255, 0.5/255].
float ditherAdjustment(uint x, uint y) {
	// Since we don't (currently) have access to the D3D12 engine's blue noise
	// textures from this part of the code, and hardcoded arrays don't seem
	// to be working, we use a Wang hash here generating white noise, from
	// http://www.reedbeta.com/blog/quick-and-easy-gpu-random-numbers-in-d3d11/.
	uint seed = (x << 16) + y;
	seed = (seed ^ 61) ^ (seed >> 16);
	seed *= 9;
	seed = seed ^ (seed >> 4);
	seed *= 0x27d4eb2d;
	seed = seed ^ (seed >> 15);
	return (0.5 - float(seed) / 2147483647.0) / 255.0;
}

// Applies dithering to an sRGB color.
// Interestingly, this does monochromatic dithering instead of using a
// different dithering pattern per channel - this correlates errors, but the
// monochromatic noise might be preferable from a visual, filmic standpoint.
// We also don't shift the dithering pattern over time, since it makes the
// output look more temporally noisy.
vec3 dither(vec3 value, vec2 texcoord0){
	vec2 pixelPositions = texcoord0 * ScreenSize.xy;
	float adjustment = ditherAdjustment(uint(abs(pixelPositions.x)), uint(abs(pixelPositions.y)));	// abs is necessary to hint to the compiler that this cast to uint is safe
	return value + adjustment;
}

ToneMappingPSOutStruct applyToneMapping(FragmentInput fragInput) {
	ToneMappingPSOutStruct psOut;

	// Original image
	vec3 preToneMapColor = texture2D(RasterColor, fragInput.texcoord0).rgb;

	// Add in the pre-processed bloom
	vec3 bloom = texture2D(gBloomBuffer, fragInput.texcoord0).rgb;
	preToneMapColor = mad(bloom, gBloomMultiplier, preToneMapColor);

	vec3 color = preToneMapColor;
	if (gToneMappingIntensity != 0.0) {
		if (gToneMappingDebugMode == 0.0) {
			// Normal tone mapping
			color = dynamicToneMapper(color);
		}
		else {
			// Debug mode
			if (fragInput.texcoord0.x < 0.25) {
				color = reinhardToneMapper(color);
			}
			else if (fragInput.texcoord0.x < 0.5) {
				color = filmicToneMapper(color);
			}
			else {
				color = dynamicToneMapper(color);
			}

			// Plot the tone curve
			float histogramValue = texture2D(gToneCurve, fragInput.texcoord0).r;
			float plotValue = 1.0 + histogramValue / 15.5876; // 15.5876 = log_2(255^2.2)
			if (fragInput.texcoord0.y > 1.0 - 0.5 * plotValue) {
				color = lerp(color, vec3(1.0, 1.0, 1.0), 0.2);
			}
		}
	}

	if (gColorGradingEnabled != 0.0) {
		color = colorGrading(color);
	}

	// gToneMappingIntensity is a 0 to 1 value...
	color = lerp(preToneMapColor, color, gToneMappingIntensity);

	// THIS IS IMPORTANT....
	//
	// The output colour buffer is configured as R8G8B8A8_UNORM
	// It is *not* configured as R8G8B8A8_UNORM_SRGB
	// However - In this case, Windows *interprets* the buffer as sRGB
	// so we need to do a manual conversion to sRGB.
	if (gPerformSRGBConversion != 0.0) {
		color = linearRGBToSRGB(color);
	}

	// Finally, apply dithering to the output color to break up banding artifacts.
	// This is only first-order; ideally, we might be performing dithering in
	// linear space while using range information from sRGB space, but the 
	// errors here should be pretty small.
	psOut.OutColor = vec4(dither(color, fragInput.texcoord0), 1.0);

	// Blend rasterized things (rain, sun, menu animation) into back buffer (after sRGB conversion)
	vec4 rasterizedThings = texture2D(gRasterizedInput, fragInput.texcoord0);
	psOut.OutColor.rgb *= 1 - rasterizedThings.a;
	psOut.OutColor.rgb += rasterizedThings.rgb;

	return psOut;
}
